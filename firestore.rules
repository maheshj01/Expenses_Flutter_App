rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Sharing needs a real (Apple / Google) account, not an anonymous one.
    function hasAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function me() {
      return request.auth.uid;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // True when [blocker] has blocked [other] (see /blocks below).
    function hasBlocked(blocker, other) {
      return exists(/databases/$(database)/documents/blocks/$(blocker + '_' + other));
    }

    function blockedEitherWay(a, b) {
      return hasBlocked(a, b) || hasBlocked(b, a);
    }

    // True while [uid]'s account waits to be deleted. Only the deletion
    // functions (functions/src/accountDeletion.ts) set or clear
    // users/{uid}.deletion; while it's there the account is frozen, so a
    // second phone still signed in can't refill it.
    function deleting(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path) && get(path).data.get('deletion', null) != null;
    }

    // ---- personal data: each user can only read and write their own ----
    // The account document holds the deletion marker, which the app can read
    // but never set or clear.
    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && request.resource.data.get('deletion', null) == null;
      allow update: if signedIn() && me() == uid
        && resource.data.get('deletion', null) == null
        && request.resource.data.get('deletion', null) == null;
      allow delete: if signedIn() && me() == uid
        && (resource == null || resource.data.get('deletion', null) == null);
    }

    match /users/{uid}/{collection}/{recordId} {
      allow read: if signedIn() && me() == uid;
      allow write: if signedIn() && me() == uid && !deleting(uid);
    }

    // ---- usernames ----
    // One document per handle makes them unique. Only exact lookups (get)
    // are allowed, so nobody can list who uses the app.
    match /handles/{handle} {
      allow get: if hasAccount();
      allow create: if hasAccount()
        && request.resource.data.uid == me()
        && handle.matches('^[a-z][a-z0-9_.]{2,19}$');
      allow update: if hasAccount() && resource.data.uid == me() && request.resource.data.uid == me();
      allow delete: if hasAccount() && resource.data.uid == me();
    }

    // Someone who blocked you can't be looked up by you, and nobody can look
    // up an account that's waiting to be deleted.
    match /profiles/{uid} {
      allow get: if hasAccount()
        && (me() == uid || (!hasBlocked(uid, me()) && !deleting(uid)));
      allow create, update: if hasAccount() && me() == uid
        && request.resource.data.keys().hasOnly(['handle', 'name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        // The handle must be claimed by the same person in the same write.
        && existsAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle))
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == me();
      allow delete: if hasAccount() && me() == uid;
    }

    // ---- connections ----
    // Id is "uidA_uidB" (sorted). The person asked is the only one who can
    // accept; either side can decline or remove. No requests between people
    // when either has blocked the other.
    match /connections/{id} {
      allow read: if hasAccount() && (resource == null || me() in resource.data.members);
      allow create: if hasAccount()
        && request.resource.data.requestedBy == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && !blockedEitherWay(request.resource.data.members[0], request.resource.data.members[1])
        && !deleting(request.resource.data.members[0])
        && !deleting(request.resource.data.members[1]);
      allow update: if hasAccount()
        && me() in resource.data.members
        && me() != resource.data.requestedBy
        && changedOnly(['status'])
        && request.resource.data.status == 'accepted'
        && !blockedEitherWay(resource.data.members[0], resource.data.members[1]);
      allow delete: if hasAccount() && me() in resource.data.members;
    }

    // ---- shared bills ----
    // The payer creates and edits (deleting is a soft delete). Every other
    // member can only add or remove the flag on their own share.
    // Bills from people you're not connected with are ignored by the app.
    match /bills/{id} {
      allow read: if hasAccount() && (resource == null || me() in resource.data.members);
      allow create: if hasAccount()
        && request.resource.data.createdBy == me()
        && me() in request.resource.data.members
        && request.resource.data.members.size() <= 20
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0;
      allow update: if hasAccount() && (
        (resource.data.createdBy == me()
          && request.resource.data.createdBy == me()
          && me() in request.resource.data.members
          && request.resource.data.members.size() <= 20
          && request.resource.data.amountCents > 0)
        ||
        (me() in resource.data.members
          && changedOnly(['flags'])
          && request.resource.data.flags.diff(resource.data.flags).affectedKeys().hasOnly([me()]))
      );
      allow delete: if false;

      // ---- edit history ----
      // What each of the payer's edits changed. Written in the same batch as
      // the bill (so `at` matches the bill's new editedAt), readable by its
      // members, and never changed or deleted.
      match /edits/{editId} {
        function billAfter() {
          return getAfter(/databases/$(database)/documents/bills/$(id)).data;
        }

        allow read: if hasAccount()
          && me() in get(/databases/$(database)/documents/bills/$(id)).data.members;
        allow create: if hasAccount()
          && request.resource.data.keys().hasOnly(['by', 'at', 'changes'])
          && request.resource.data.by == me()
          && billAfter().createdBy == me()
          && request.resource.data.at is int
          && request.resource.data.at == billAfter().editedAt
          && request.resource.data.changes is map
          && request.resource.data.changes.size() <= 12;
        allow update, delete: if false;
      }
    }

    // ---- settlements ----
    match /settlements/{id} {
      allow read: if hasAccount() && (resource == null || me() in resource.data.members);
      allow create: if hasAccount()
        && request.resource.data.createdBy == me()
        && me() in request.resource.data.members
        && request.resource.data.members == [request.resource.data.from, request.resource.data.to]
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0;
      allow delete: if hasAccount() && resource.data.createdBy == me();
    }

    // ---- blocking ----
    // "blocker_blocked". Only the blocker sees or removes it; the rules
    // above use it to refuse requests and profile lookups.
    match /blocks/{id} {
      allow read: if hasAccount() && resource.data.blocker == me();
      allow create: if hasAccount()
        && request.resource.data.keys().hasOnly(['blocker', 'blocked', 'profile', 'at'])
        && request.resource.data.blocker == me()
        && request.resource.data.blocked is string
        && request.resource.data.blocked != me()
        && id == me() + '_' + request.resource.data.blocked;
      allow delete: if hasAccount() && resource.data.blocker == me();
    }

    // ---- reports ----
    // Write-only. Moderators read them in the Firebase console.
    match /reports/{id} {
      allow create: if hasAccount()
        && request.resource.data.keys().hasOnly(
          ['reporter', 'reportedUid', 'reported', 'reason', 'note', 'billId', 'at', 'createdAt'])
        && request.resource.data.reporter == me()
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != me()
        && request.resource.data.reason in ['spam', 'harassment', 'offensive', 'impersonation', 'other']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt == request.time;
    }
  }
}
